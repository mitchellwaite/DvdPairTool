*.id2

# Editor
*.swp
*~
.vs/

# Keep the console font source even though *.xpr-like binaries are build-ish
!font.xpr

# ATG framework comes from the SDK (AtgFramework-installer.bat), except the files we changed
/atg/*
!/atg/Common/
/atg/Common/*
!/atg/Common/AtgConsole.cpp
!/atg/Common/AtgConsole.h
!/atg/Common/AtgResource.cpp

# Keep the vendored XexTool despite *.exe above
!tools/XexTool.exe
