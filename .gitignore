# Build output
*.o
*.obj
*.exe
*.pe
*.pdb
*.xdb
*.lib
*.xex
*.map
/bin/
/obj/
/Debug/
/Release/

# IDA artifacts (if analysis files ever land here)
*.i64
*.idb
*.til
*.nam
*.id0
